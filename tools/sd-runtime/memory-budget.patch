diff --git a/src/core/memory_budget.h b/src/core/memory_budget.h
new file mode 100644
index 0000000..9dd8e72
--- /dev/null
+++ b/src/core/memory_budget.h
@@ -0,0 +1,76 @@
+#pragma once
+
+#include <cstdint>
+#include <fstream>
+#include <string>
+#include "ggml-backend.h"
+#include "stable-diffusion.h"
+
+void log_printf(sd_log_level_t level, const char* file, int line, const char* format, ...);
+
+namespace sd {
+    inline bool fits_ram_budget(uint64_t required, uint64_t available) {
+        constexpr uint64_t reserve = 512ull * 1024 * 1024;
+        return required == 0 || (available >= reserve && required <= available - reserve);
+    }
+
+    inline thread_local std::string memory_budget_error;
+    inline thread_local const char* memory_budget_phase = "load";
+
+    inline uint64_t available_ram() {
+        std::ifstream meminfo("/proc/meminfo");
+        std::string line;
+        while (std::getline(meminfo, line)) {
+            if (line.compare(0, 13, "MemAvailable:") == 0) {
+                try {
+                    return std::stoull(line.substr(13)) * 1024;
+                } catch (const std::exception&) {
+                    break;
+                }
+            }
+        }
+        return 0;
+    }
+
+    inline bool refuse_memory(const char* phase, const char* resource, uint64_t required, uint64_t available) {
+        memory_budget_error = std::string("omni_memory_budget phase=") + phase +
+            " resource=" + resource + " required=" + std::to_string(required) +
+            " available=" + std::to_string(available);
+        log_printf(SD_LOG_ERROR, __FILE__, __LINE__, "%s", memory_budget_error.c_str());
+        return false;
+    }
+
+    inline bool memory_budget_allows_ram(const char* phase, uint64_t bytes) {
+        auto available = available_ram();
+        constexpr uint64_t reserve = 512ull * 1024 * 1024;
+        return fits_ram_budget(bytes, available) ||
+               refuse_memory(phase, "ram", bytes, available > reserve ? available - reserve : 0);
+    }
+
+    inline bool memory_budget_allows(const char* phase, ggml_backend_buffer_type_t type, size_t bytes) {
+        if (bytes == 0) {
+            return true;
+        }
+        if (ggml_backend_buft_is_host(type)) {
+            return memory_budget_allows_ram(phase, bytes);
+        }
+        size_t free = 0;
+        size_t total = 0;
+        auto device = ggml_backend_buft_get_device(type);
+        if (device != nullptr) {
+            ggml_backend_dev_memory(device, &free, &total);
+        }
+        if (total == 0 || free >= total) {
+            return refuse_memory(phase, "vram_unknown", bytes, 0);
+        }
+        constexpr uint64_t reserve = 512ull * 1024 * 1024;
+        auto available = free > reserve ? free - reserve : 0;
+        if (bytes > available) {
+            return refuse_memory(phase, "vram", bytes, available);
+        }
+        if (ggml_backend_dev_type(device) == GGML_BACKEND_DEVICE_TYPE_IGPU) {
+            return memory_budget_allows_ram(phase, bytes);
+        }
+        return true;
+    }
+}
diff --git a/src/core/image_crop.h b/src/core/image_crop.h
new file mode 100644
index 0000000..d6122d9
--- /dev/null
+++ b/src/core/image_crop.h
@@ -0,0 +1,29 @@
+#pragma once
+
+#include <cstddef>
+#include <cstring>
+
+#include "stable-diffusion.h"
+
+namespace sd {
+    inline bool center_crop(sd_image_t& image, uint32_t width, uint32_t height) {
+        if (image.data == nullptr || width == 0 || height == 0 || image.channel == 0 ||
+            width > image.width || height > image.height) {
+            return false;
+        }
+        if (image.width == width && image.height == height) {
+            return true;
+        }
+        const size_t left = (image.width - width) / 2;
+        const size_t top = (image.height - height) / 2;
+        const size_t source_stride = size_t(image.width) * image.channel;
+        const size_t target_stride = size_t(width) * image.channel;
+        const auto* start = image.data + top * source_stride + left * image.channel;
+        for (size_t row = 0; row < height; ++row) {
+            std::memmove(image.data + row * target_stride, start + row * source_stride, target_stride);
+        }
+        image.width = width;
+        image.height = height;
+        return true;
+    }
+}
