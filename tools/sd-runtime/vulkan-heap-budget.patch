+static bool omni_heap_can_allocate(const vk_device & device, uint32_t type, size_t bytes, std::string & refusal) {
+    const auto fail = [&](const char * resource, uint64_t available) {
+        refusal = std::string("omni_heap_budget resource=") + resource +
+                  " required=" + std::to_string(bytes) + " available=" + std::to_string(available);
+        return false;
+    };
+    const auto extensions = device->physical_device.enumerateDeviceExtensionProperties();
+    if (std::none_of(extensions.begin(), extensions.end(), [](const auto & ext) {
+            return std::string(ext.extensionName.data()) == VK_EXT_MEMORY_BUDGET_EXTENSION_NAME;
+        })) {
+        return fail("vram_unknown", 0);
+    }
+
+    vk::PhysicalDeviceMemoryBudgetPropertiesEXT budget;
+    vk::PhysicalDeviceMemoryProperties2 props;
+    props.pNext = &budget;
+    device->physical_device.getMemoryProperties2(&props);
+    const auto & memory = props.memoryProperties;
+    const auto heap_index = memory.memoryTypes[type].heapIndex;
+    const auto & heap = memory.memoryHeaps[heap_index];
+    const auto ceiling = std::min(heap.size, budget.heapBudget[heap_index]);
+    const auto used = budget.heapUsage[heap_index];
+    if (used > ceiling || bytes > ceiling - used) {
+        return fail((device->uma || !(heap.flags & vk::MemoryHeapFlagBits::eDeviceLocal))
+                        ? "ram" : "vram", used > ceiling ? 0 : ceiling - used);
+    }
+    if (device->uma || !(heap.flags & vk::MemoryHeapFlagBits::eDeviceLocal)) {
+        std::ifstream input("/proc/meminfo");
+        std::string line;
+        while (std::getline(input, line)) {
+            if (line.compare(0, 13, "MemAvailable:") == 0) {
+                try {
+                    constexpr uint64_t reserve = 512ull * 1024 * 1024;
+                    const auto available = std::stoull(line.substr(13)) * 1024;
+                    const auto usable = available > reserve ? available - reserve : 0;
+                    return bytes <= usable || fail("ram", usable);
+                } catch (const std::exception &) {
+                    break;
+                }
+            }
+        }
+        return fail("ram", 0);
+    }
+    return true;
+}
